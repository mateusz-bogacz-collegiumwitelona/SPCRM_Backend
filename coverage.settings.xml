<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <Functions>
      <Exclude>
        <!-- Api -->
        <Function>.*Api\.Configuration\..*</Function>
        <Function>.*Api\.Mappers\..*</Function>
        <Function>.*Api\.Policy\..*</Function>
        <Function>.*Api\.Properties\..*</Function>
        <Function>.*Api\.Request\..*</Function>
        <Function>.*Api\.Transformers\..*</Function>
        <Function>.*Api\.Controllers\..*</Function>
        <Function>.*Api\.Factory\..*</Function>

        <!-- Domain -->
        <Function>.*Domain\.Common\..*</Function>
        <Function>.*Domain\.Constants\..*</Function>
        <Function>.*Domain\.Domain\..*</Function>
        <Function>.*Domain\.Enum\..*</Function>
        <Function>.*Domain\.Models\..*</Function>

        <!-- Email -->
        <Function>.*Email\.Templates\..*</Function>
        <Function>.*Email\.DependencyInjection.*</Function>

        <!-- Infrastructure -->
        <Function>.*Infrastructure\.Factory\..*</Function>
        <Function>.*Infrastructure\.Migrations\..*</Function>
        <Function>.*Infrastructure\.Seeders\..*</Function>
        <Function>.*Infrastructure\.AppDbContext.*</Function>
        <Function>.*Infrastructure\.DependencyInjection.*</Function>

        <!-- Services -->
        <Function>.*Services\.Command\..*</Function>
        <Function>.*Services\.Factory\..*</Function>
        <Function>.*Services\.Interfaces\..*</Function>
        <Function>.*Services\.Response\..*</Function>
        <Function>.*Services\.DependencyInjection.*</Function>

        <!-- Worker -->
        <Function>.*Worker\.DependencyInjection.*</Function>
      </Exclude>
    </Functions>
    <Sources>
      <Exclude>
        <Source>.*[\\/](bin|obj|TestResults|Migrations)[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>